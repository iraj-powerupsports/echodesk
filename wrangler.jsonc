{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echodesk",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    // Replace database_id with the id printed by `npx wrangler d1 create echodesk`.
    { "binding": "DB", "database_name": "echodesk", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "vars": { "MODEL": "claude-haiku-5-5" }
}
